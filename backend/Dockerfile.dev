# Dockerfile.dev for offline development
# This image has Air + Go installed for hot reloading

FROM docker.io/library/golang:1.24-bookworm

# Install build dependencies
RUN apt-get update && apt-get install -y gcc g++ make && rm -rf /var/lib/apt/lists/*

# Install Air for hot reload
RUN go install github.com/air-verse/air@v1.52.3

WORKDIR /app

# Pre-download modules to cache dependencies
COPY go.mod go.sum ./
RUN go mod download

# Source code is mounted at runtime
CMD ["air"]
